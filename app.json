                "display_name": "Session ID"
              },
              "data_template": {
                "type": "str",
                "value": "{text}",
                "display_name": "Data Template"
              }
            },
            "outputs": [
              { "name": "message", "display_name": "Message", "types": ["Message"] }
            ]
          }
        }
      }
