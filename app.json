              "sender": {
                "type": "str",
                "value": "Machine",
                "display_name": "Sender"
              },
              "sender_name": {
                "type": "str",
                "value": "KisanMitra AI",
                "display_name": "Sender Name"
              },
              "session_id": {
                "type": "str",
